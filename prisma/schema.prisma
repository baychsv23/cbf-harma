// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  USER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum BooleanState {
  TRUE
  FALSE
}

enum Category {
  NUTRITION_ELECTROLYTE // Corrected spelling (Electrolyte)
  ANTIBIOTICS
  ANTI_PARASITIC
  GASTROINTESTINAL // Corrected (One word is standard for clinical use)
  CARDIOVASCULAR
  ANTI_DIABETIC
  RESPIRATORY
  ANTI_ALLERGIC
  EFFECTIVE_TO_PSYCHOTIC
  ANESTHETICS
  ANALGESIC_ANTIPYRETIC
  VITAMINS_MINERALS // Corrected spelling (Vitamins)
  DISINFECTANTS_ANTISEPTIC
  OTHERS
}

enum CategorySub {
  NONE

  // Sub-categories for ANTIBIOTICS (07)
  PENICILLINS
  CEPHALOSPORINS
  MACROLIDES
  QUINOLONES
  SULFONAMIDES
  TINIDAZOLES // Corrected from image (Tinidazole group)
  AMINOGLYCOSIDES // Corrected spelling (Aminoglycosides)
}

enum Permission {
  USER_VIEW
  USER_CREATE
  USER_UPDATE
  USER_DELETE

  PRODUCT_VIEW
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE

  ARTICLE_VIEW
  ARTICLE_CREATE
  ARTICLE_UPDATE
  ARTICLE_DELETE

  ANNOUNCEMENT_VIEW
  ANNOUNCEMENT_CREATE
  ANNOUNCEMENT_UPDATE
  ANNOUNCEMENT_DELETE

  SYMPTOM_VIEW
  SYMPTOM_CREATE
  SYMPTOM_UPDATE
  SYMPTOM_DELETE
}

model User {
  id              String       @id @default(uuid())
  userName        String       @unique
  fullName        String?
  password        String
  isActive        BooleanState @default(TRUE)
  permissions     Json?
  role            Role         @default(USER)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  articlesCreator Article[]    @relation("ArticleCreator")
  articlesUpdater Article[]    @relation("ArticleUpdater")
  productsCreator Product[]    @relation("ProductCreator")
  productsUpdater Product[]    @relation("ProductUpdater")
}

model Product {
  id                   String       @id @default(uuid())
  slug                 String       @unique // URL ທີ່ສວຍງາມ (SEO) e.g., freecold-paracetamol
  sku                  String       @unique
  nameLA               String
  nameEN               String
  genericName          String? // ຊື່ສາມັນທາງຢາ e.g., 
  dosage               String? // 500mg
  packaging            String? // ຮູບແບບບັນຈຸ e.g., 10 tablets/strip
  indicationLA         String?      @db.Text // ສັບພະຄຸນ
  indicationEN         String?      @db.Text
  isPrescription       BooleanState @default(FALSE) // ຕ້ອງມີໃບສັ່ງແພດບໍ່?
  isActive             BooleanState @default(TRUE)
  productImage         String?
  productImagePublicId String?
  category             Category
  categorySub          CategorySub

  articles Article[] // MedThai Concept: ບົດຄວາມສຸຂະພາບທີ່ກ່ຽວຂ້ອງ (Many-to-Many)
  symptoms Symptom[] // Smart Search: ຢານີ້ແກ້ອາການ

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("ProductCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("ProductUpdater", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum ImageType {
  BANNER
  ANNOUNCEMENT
}

model Announcement {
  id            String       @id @default(uuid())
  image         String?
  imagePublicId String?
  type          ImageType    @default(BANNER)
  isPublic      BooleanState @default(TRUE) // Added to control visibility
  createdAt     DateTime     @default(now())
}

model Symptom {
  id        String    @id @default(uuid())
  nameLA    String // e.g., ປວດຫົວ, ເປັນໄຂ້, ໄອ
  nameEN    String
  products  Product[] // ກົດ "ປວດຫົວ" ຈະເຈິຢາຫຍັງແດ່
  createdAt DateTime  @default(now())
}

model Article {
  id                 String        @id @default(uuid())
  slug               String        @unique
  titleLA            String
  titleEN            String
  contentLA          String        @db.Text // Rich Text (HTML)
  contentEN          String        @db.Text
  coverImage         String?
  coverImagePublicId String?
  year               Int
  month              Int
  type               ArticleType   @default(HEALTH_KNOWLEDGE)
  status             ArticleStatus @default(DRAFT) // Added status field
  // Relations
  products           Product[] // Tie-in: ບົດຄວາມນີ້ແນະນຳຢາໂຕໃດ (MedThai Ref)

  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation("ArticleCreator", fields: [createdById], references: [id])
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   User?     @relation("ArticleUpdater", fields: [updatedById], references: [id])
}

enum ArticleType {
  NEWS // ຂ່າວປະຊາສຳພັນ/CSR
  HEALTH_KNOWLEDGE // ບົດຄວາມສຸຂະພາບ
  ACTIVITY // ກິດຈະກຳບໍລິສັດ
}
