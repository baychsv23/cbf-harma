// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  USER
}

enum ActiveState {
  ACTIVE
  INACTIVE
}

enum Permission {
  USER_VIEW
  USER_CREATE
  USER_UPDATE
  USER_DELETE

  PRODUCT_VIEW
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_DELETE
}

model User {
  id          String       @id @default(uuid())
  userName    String       @unique
  fullName    String?
  password    String
  isActive    BooleanState @default(TRUE)
  permissions Json?
  role        Role         @default(USER)
}

model Product {
  id              String       @id @default(uuid())
  status          ActiveState  @default(ACTIVE)
  slug            String       @unique // URL ທີ່ສວຍງາມ (SEO) e.g., freecold-paracetamol
  sku             String       @unique
  nameEN          String
  nameLA          String
  descriptionsLA  String?      @db.Text
  descriptionsEN  String?      @db.Text
  genericName     String? // ຊື່ສາມັນທາງຢາ e.g., 
  dosage          String? // 500mg
  packaging       String? // ຮູບແບບບັນຈຸ e.g., 10 tablets/strip
  indicationLa    String?      @db.Text // ສັບພະຄຸນ
  indicationEn    String?      @db.Text
  isBestSeller    BooleanState @default(FALSE)
  isPrescription  BooleanState @default(FALSE) // ຕ້ອງມີໃບສັ່ງແພດບໍ່?
  isActive        BooleanState @default(TRUE)
  productImageUrl String?
  category        Category
  categorySub     CategorySub

  articles Article[] // MedThai Concept: ບົດຄວາມສຸຂະພາບທີ່ກ່ຽວຂ້ອງ (Many-to-Many)
  symptom  Symptom[] // Smart Search: ຢານີ້ແກ້ອາການ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ImageType {
  BANNER
  ANNOUNCEMENT
}

model Announcement {
  id       String    @id @default(uuid())
  imageUrl String // limit create only 5 items
  type     ImageType @default(BANNER)
}

model Symptom {
  id       String    @id @default(uuid())
  nameLa   String // e.g., ປວດຫົວ, ເປັນໄຂ້, ໄອ
  nameEn   String
  products Product[] // ກົດ "ປວດຫົວ" ຈະເຈິຢາຫຍັງແດ່
}

enum articleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id         String  @id @default(uuid())
  slug       String  @unique
  titleLa    String
  titleEn    String
  contentLa  String  @db.Text // Rich Text (HTML)
  contentEn  String  @db.Text
  coverImage String?

  type ArticleType @default(HEALTH_KNOWLEDGE)

  // Relations
  products Product[] // Tie-in: ບົດຄວາມນີ້ແນະນຳຢາໂຕໃດ (MedThai Ref)

  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum ArticleType {
  NEWS // ຂ່າວປະຊາສຳພັນ/CSR
  HEALTH_KNOWLEDGE // ບົດຄວາມສຸຂະພາບ
  ACTIVITY // ກິດຈະກຳບໍລິສັດ
}

enum BooleanState {
  TRUE
  FALSE
}

enum Category {
  TEST
}

enum CategorySub {
  TEST
}
